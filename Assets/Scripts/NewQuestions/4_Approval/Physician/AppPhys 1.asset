  m_Script: {fileID: 11500000, guid: 60af0432a3c869e48a591344a8dafd71, type: 3}
  m_Name: AppPhys 1
  m_EditorClassIdentifier: 
  question: "A new cancer treatment has been approved and works well, but it requires
    frequent clinic visits. You talk with your patients about how this treatment
    might affect their daily life before deciding if it\u2019s the best option.\n\n<b>Physicians
    must consider real-life factors to help patients choose treatments they can realistically
    manage\u2014even if the medical results look promising</b>\n\nIs this <b>true</b>
    or <b>false</b>?"
  explanation: "Physicians think beyond biology\u2014they consider things like a
    patient\u2019s schedule, transportation, support system, and personal goals.
    This helps them recommend treatments that fit a patient\u2019s real life, not
    just their diagnosis, so care is both effective and manageable. By personalizing
    treatment choices in this way, physicians help patients feel supported and more
    likely to stay on track with their care."
  correctAnswer: True
  incorrectAnswer1: False
  incorrectAnswer2: 
  incorrectAnswer3: 
  questionRole: Physician
  questionType: TrueFalse
  questionStage: Approval
