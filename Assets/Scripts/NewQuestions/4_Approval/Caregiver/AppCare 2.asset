  m_Script: {fileID: 11500000, guid: 60af0432a3c869e48a591344a8dafd71, type: 3}
  m_Name: AppCare 2
  m_EditorClassIdentifier: 
  question: 'You and other caregivers have reported that although the new treatment
    is controlling the cancer, many patients experience worsening fatigue and dizziness
    months after starting the new treatment.


    <b>Feedback from patients and
    caregivers helps uncover side effects and challenges that may emerge after a
    treatment is used more widely.</b>


    Is this <b>true</b> or <b>false</b>?'
  explanation: "Once a cancer treatment is approved and used more widely, researchers
    continue to monitor how it affects people in real life through post-market surveillance.
    Feedback from patients and caregivers helps uncover side effects\u2014like fatigue
    or dizziness\u2014that may appear months later or affect daily life, allowing
    researchers and clinicians to improve safety guidance, monitoring, and patient
    support over time."
  correctAnswer: True
  incorrectAnswer1: False
  incorrectAnswer2: 
  incorrectAnswer3: 
  questionRole: Caregiver
  questionType: TrueFalse
  questionStage: Approval
