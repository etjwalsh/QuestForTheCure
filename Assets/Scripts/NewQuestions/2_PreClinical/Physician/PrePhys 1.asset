  m_Script: {fileID: 11500000, guid: 60af0432a3c869e48a591344a8dafd71, type: 3}
  m_Name: PrePhys 1
  m_EditorClassIdentifier: 
  question: 'You are reviewing the preclinical data for a new treatment that is being
    tested in mice, and the results seem promising.


    <b>The treatment is already
    shrinking tumors in mice, so it should work just as well in people.</b>


    Is
    this <b>true</b> or <b>false</b>?'
  explanation: "Just because a treatment works well in animals doesn\u2019t mean
    it will work the same way in people. Human biology can be very different, and
    some therapies that look promising in preclinical studies don\u2019t end up being
    effective or safe in patients. Physicians help the research team interpret these
    early results in a real-world, human context, which makes it more likely that
    future treatments will truly benefit patients."
  correctAnswer: False
  incorrectAnswer1: True
  incorrectAnswer2: 
  incorrectAnswer3: 
  questionRole: Physician
  questionType: TrueFalse
  questionStage: PreClinical
