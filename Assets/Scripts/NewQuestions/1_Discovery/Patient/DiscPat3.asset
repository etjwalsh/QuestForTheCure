  m_Script: {fileID: 11500000, guid: 60af0432a3c869e48a591344a8dafd71, type: 3}
  m_Name: DiscPat3
  m_EditorClassIdentifier: 
  question: "You\u2019re meeting with the lead researcher \u2014 <b>Principal Investigator</b>
    (PI) \u2014 of a research team at your cancer center. He explains how patient
    insights help guide research priorities and study design, making the research
    more relevant and meaningful to patients.\n\n<b>What does a PI do, and how does
    it affect patients right before trials begin?</b>"
  explanation: "The PI is the lead researcher who ensures the study is carried out
    properly, following ethical and scientific standards to protect patients. Equally
    important, the PI listens to patients \u2014 through feedback, advocacy groups,
    or shared experiences \u2014 to make sure the research focuses on areas that
    truly matter to people living with the disease."
  correctAnswer: 'D: A and C'
  incorrectAnswer1: 'A: Lead the research project and make sure it follows ethical
    and scientific standards'
  incorrectAnswer2: 'B: Approve or reject a new experimental drug or treatment'
  incorrectAnswer3: 'C: Use patient insights and samples to guide the research direction'
  questionRole: Patient
  questionType: MultipleChoice
  questionStage: Discovery
