  m_Script: {fileID: 11500000, guid: 60af0432a3c869e48a591344a8dafd71, type: 3}
  m_Name: DiscCare 2
  m_EditorClassIdentifier: 
  question: 'A research team is surveying patients and caregivers about what matters
    most to during cancer treatment. You help by sharing the survey with other caregivers,
    patients, and their families so their voices are heard.


    <b>By connecting
    patients, families, and caregivers with researchers, their input can help guide
    what scientists focus on early in the research process.</b>


    Is this <b>true</b>
    or <b>false</b>?'
  explanation: "Caregivers often serve as a bridge between researchers and the patient
    community. Their involvement helps ensure early research reflects real-life needs,
    priorities, and challenges faced by those living with cancer, ensuring that early
    discoveries are guided by real experiences\u2014not just laboratory data. Their
    voices keep research grounded on the human side of cancer care from the very
    beginning."
  correctAnswer: True
  incorrectAnswer1: False
  incorrectAnswer2: 
  incorrectAnswer3: 
  questionRole: Caregiver
  questionType: TrueFalse
  questionStage: Discovery
