  m_Script: {fileID: 11500000, guid: 60af0432a3c869e48a591344a8dafd71, type: 3}
  m_Name: PatTri_2
  m_EditorClassIdentifier: 
  question: "Your doctor recently discussed a clinical trial with you as a potential
    alternative to the standard treatment you\u2019ve been receiving. While attending
    a support group later that week, another patient tells you, \u201COne of the
    benefits of clinical trials is that patients may get access to promising treatments
    before they\u2019re widely available.\u201D This brings you hope, but is it too
    good to be true?"
  explanation: "Clinical trials are the main way new treatments are tested, so participating
    can give patients access to promising new treatments that aren\u2019t yet available
    to the public. While there\u2019s no guarantee the new treatment will work better
    than the standard treatment, trials are designed so patient participants still
    receive the best-known standard care. This helps protect patients while also
    advancing research for future treatments."
  correctAnswer: True
  incorrectAnswer1: False
  incorrectAnswer2: 
  incorrectAnswer3: 
  questionRole: Patient
  questionType: TrueFalse
  questionStage: Trials
