  m_Script: {fileID: 11500000, guid: 60af0432a3c869e48a591344a8dafd71, type: 3}
  m_Name: PatApp_3
  m_EditorClassIdentifier: 
  question: "Over lunch, you are reflecting on your experience participating in a
    clinical trial with your caregiver. Both of you are especially curious about
    the results of the study \u2013 was the new treatment effective? Is it going
    to be available to other patients? Your caregiver mentions, \u201CI\u2019m sure
    that, after a clinical trial ends, patients can learn about the overall results
    of the study once the findings are officially reviewed and published.\u201D\r\n\r\nIs
    this true or false?\r"
  explanation: "Although results aren\u2019t available immediately after the trial
    ends, patient participants often receive updates once the findings have been
    reviewed and officially released. These results may be shared through newsletters,
    follow-up reports, or even public announcements. Learning about the outcome helps
    patients see the value of their participation, knowing their involvement contributed
    to knowledge that could improve future care and bring new treatments closer to
    helping more people."
  correctAnswer: True
  incorrectAnswer1: False
  incorrectAnswer2: 
  incorrectAnswer3: 
  questionRole: Patient
  questionType: TrueFalse
  questionStage: Approval
