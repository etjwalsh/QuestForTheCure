  m_Script: {fileID: 11500000, guid: 60af0432a3c869e48a591344a8dafd71, type: 3}
  m_Name: PatDisc_2
  m_EditorClassIdentifier: 
  question: "At your cancer center, you hear about an opportunity to join a patient
    advisory board that works with researchers. This group helps scientists understand
    what matters most to patients, like which symptoms affect daily life the most
    or what side effects are hardest to manage. You wonder, \u201Cdoes this mean
    that patients can influence what scientists choose to study by joining advisory
    boards or advocacy groups?\u201D\nIs this True or False?"
  explanation: "Patients guide research priorities by helping researchers understand
    what matters most in everyday life with a disease \u2014 such as managing symptoms,
    reducing side effects, or improving quality of life. By sharing these insights
    early, patients help guide what research questions are asked, which areas are
    prioritized, and how studies are designed, making the research more relevant
    and meaningful for the people it is meant to benefit."
  correctAnswer: True
  incorrectAnswer1: False
  incorrectAnswer2: 
  incorrectAnswer3: 
  questionRole: Patient
  questionType: TrueFalse
  questionStage: Discovery
